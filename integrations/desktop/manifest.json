{
  "manifest_version": "0.3",
  "name": "firefly-agent-bridge",
  "display_name": "Firefly Agent Bridge",
  "version": "0.2.7",
  "description": "Local developer jobs and workflows through official coding agents.",
  "long_description": "Run a durable local queue, scoped authentication, workflows, audit and a management console. Claude Code or Codex uses your own official subscription login. Default permissions are enabled; explicit bypass requires a trusted host.",
  "author": {
    "name": "Firefly Software Foundation",
    "url": "https://github.com/fireflyframework"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fireflyframework/firefly-agent-bridge"
  },
  "homepage": "https://github.com/fireflyframework/firefly-agent-bridge",
  "documentation": "https://github.com/fireflyframework/firefly-agent-bridge/blob/main/docs/installation.md",
  "support": "https://github.com/fireflyframework/firefly-agent-bridge/issues",
  "icon": "assets/logo.png",
  "screenshots": ["assets/dashboard.png"],
  "server": {
    "type": "binary",
    "entry_point": "server/firefly-bridge",
    "mcp_config": {
      "command": "${__dirname}/server/firefly-bridge",
      "args": ["mcp"]
    }
  },
  "tools_generated": true,
  "keywords": [
    "orchestration",
    "workflows",
    "local",
    "queue",
    "sse",
    "openai-compatible",
    "pydantic-ai"
  ],
  "license": "Apache-2.0",
  "compatibility": {
    "platforms": ["darwin", "win32"]
  }
}
